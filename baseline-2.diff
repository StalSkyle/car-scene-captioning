+"""Confidence thresholds shared by the pipeline and its model components."""
+
+import math
+from numbers import Real
+
+
+DEFAULT_CAR_CONFIDENCE = 0.25
+DEFAULT_OBJECT_CONFIDENCE = 0.25
+DEFAULT_SCENE_CONFIDENCE = 0.5
+
+
+def validate_confidence_threshold(value, name):
+    """Return a finite probability, or raise ValueError for an invalid threshold."""
+    if (isinstance(value, bool) or not isinstance(value, Real)
+            or not math.isfinite(value) or not 0 <= value <= 1):
+        raise ValueError(f"{name} must be a finite number between 0 and 1")
+    return float(value)
