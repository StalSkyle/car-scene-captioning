@@ -0,0 +1,13 @@
+"""Shared validation for confidence thresholds used by the pipeline."""
+
+import math
+from numbers import Real
+
+
+def validate_confidence_threshold(value: Real, name: str) -> float:
+    """Return a finite threshold in [0, 1], rejecting booleans and other types."""
+    if isinstance(value, bool) or not isinstance(value, Real):
+        raise TypeError(f"{name} must be a number between 0 and 1")
+    if not math.isfinite(value) or not 0 <= value <= 1:
+        raise ValueError(f"{name} must be a finite number between 0 and 1")
+    return float(value)
