+++ b/tests/test_feature_extractor.py
@@ -0,0 +1,70 @@
+import math
+
+import pytest
+import torch
+from PIL import Image
+
+
+class FakeBox:
+    def __init__(self, class_id, confidence):
+        self.cls = class_id
+        self.conf = confidence
+
+
+class FakeResult:
+    def __init__(self, boxes):
+        self.boxes = boxes
+        self.names = {0: "tree", 1: "building"}
+
+
+class FakeModel:
+    def __init__(self, results):
+        self.results = results
+        self.calls = []
+
+    def __call__(self, image, verbose=False, conf=None):
+        self.calls.append((image, verbose, conf))
+        return self.results
+
+
+def test_object_extractor_filters_and_keeps_highest_confidence(feature_extractor_module):
+    extractor = feature_extractor_module.ObjectExtractor.__new__(
+        feature_extractor_module.ObjectExtractor
+    )
+    extractor.object_detection_model = FakeModel([
+        FakeResult([
+            FakeBox(0, 0.6), FakeBox(1, 0.59),
+            FakeBox(0, 0.8), FakeBox(0, 0.7),
+        ])
+    ])
+    image = object()
+
+    assert extractor.extract_features(image, confidence_threshold=0.6) == {"tree": 0.8}
+    assert extractor.object_detection_model.calls == [(image, False, 0.6)]
+
+
+def test_scene_extractor_filters_probabilities(feature_extractor_module):
+    extractor = feature_extractor_module.SceneExtractor.__new__(
+        feature_extractor_module.SceneExtractor
+    )
+    extractor.scene_classification_model = lambda image: torch.tensor([
+        [0.0, math.log(3), -math.log(3), 0.0, 0.0, 0.0, 0.0]
+    ])
+
+    result = extractor.predict_scene(
+        Image.new("RGB", (8, 8)), confidence_threshold=0.5
+    )
+
+    assert "residential" not in result
+    assert result["other"] == 0.5
+    assert result["highway"] > 0.7
+
+
+@pytest.mark.parametrize("method_name", ["extract_features", "predict_scene"])
+def test_extractors_reject_invalid_thresholds(feature_extractor_module, method_name):
+    cls = (feature_extractor_module.ObjectExtractor if method_name == "extract_features"
+           else feature_extractor_module.SceneExtractor)
+    extractor = cls.__new__(cls)
+
+    with pytest.raises(ValueError, match="confidence_threshold"):
+        getattr(extractor, method_name)(object(), confidence_threshold=-0.1)
